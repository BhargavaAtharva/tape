# Server (cmd/tape). Every variable is optional; these are the defaults.
# Render sets PORT itself.
PORT=8081
# NAME:price_scale:reference_price, comma separated. Append new symbols at the
# end only: a symbol's position is part of its order ids. The reference price
# also centres the static price band.
TAPE_SYMBOLS=BTC-USD:2:64250,ETH-USD:2:3120,SOL-USD:3:148.5,NIFTY:2:24350
# Write-ahead log and snapshots go here. Empty runs in memory only.
TAPE_DATA_DIR=data
# batch: fsync every group commit. interval: fsync every TAPE_WAL_SYNC_INTERVAL.
# none: leave flushing to the OS.
TAPE_WAL_SYNC=batch
TAPE_WAL_SYNC_INTERVAL=10ms
TAPE_SNAPSHOT_EVERY=50000
# Comma-separated browser origins allowed by CORS and the WebSocket handshake.
TAPE_CORS_ORIGINS=*
# Requests per second per client address for order entry and order queries
# (0 disables).
TAPE_RATE_LIMIT=20
# Reverse proxies in front of the server; the client address is that many
# entries from the right of X-Forwarded-For. 0 uses the TCP peer.
TAPE_PROXY_HOPS=0
# Pre-trade risk checks for orders from outside.
TAPE_COLLAR_PCT=10
TAPE_STATIC_BAND_PCT=25
TAPE_MAX_ORDER_QTY=10000
TAPE_MAX_NOTIONAL=5000000
TAPE_ORDER_TTL=30m
# Market data conflation period, and how many messages a WebSocket client may
# fall behind by before it is dropped.
TAPE_FEED_INTERVAL=100ms
TAPE_FEED_BUFFER=512
# Bot traders.
TAPE_SIM=true
TAPE_SIM_INTENSITY=0.5
# 0 picks a seed from the clock.
TAPE_SIM_SEED=0
